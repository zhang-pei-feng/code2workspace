FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PREFIX=/opt/spades
ENV PATH=/opt/spades/bin:${PATH}

RUN apt-get update -o Acquire::Retries=5 && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    python3 \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libncurses5-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src/spades
COPY . /opt/src/spades

RUN PREFIX=/opt/spades bash ./spades_compile.sh -j4

WORKDIR /work
CMD ["/bin/bash"]
